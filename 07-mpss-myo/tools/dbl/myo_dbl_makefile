#Directory and file============================

#KNCCOMPILER          = /usr/linux-k1om-4.7/linux-k1om
KNCCOMPILER           = /opt/mpss/2.2/sysroots/k1om-mpss-linux
#KNCPREFIX            = /usr/linux-k1om-4.7/bin/x86_64-k1om-linux-
KNCPREFIX             = /opt/mpss/2.2/sysroots/x86_64-mpsssdk-linux/usr/bin/k1om-mpss-linux/k1om-mpss-linux-

MYO_HOME = ../../
DBL_HOME = .
OUT_DIR = $(DBL_HOME)/bin
INCL_DIRS = -I$(DBL_HOME) \
			-I$(MYO_ROOT)/include\
            -I/usr/include \

DBL_C_SRCS = myo_dbl.c

HAS_DEBUGGER = -DHAS_DEBUGGER

DBL_SERVICE_C_OBJS = $(DBL_C_SRCS:.c=.service.o)
DBL_CLIENT_C_OBJS = $(DBL_C_SRCS:.c=.client.o)

# -------------------Host side --------------------- #
HOST_CC         =       gcc
HOST_CXX        =       g++
HOST_LD         =       g++
HOST_AR         =       ar

HOST_OBJ_SUFF   =       o

HOST_DEFS =

HOST_CFLAGS     =       -O0 -g -std=c89
HOST_CXXFLAGS   =       -O0 -g
HOST_LDFLAGS    = 
HOST_LD_OFLAG   =       -o

# ------------------- Card side --------------------- #
CARD_DEFS = -DMYOI_DMA_COMM  # Enable DMA for data transfer from XEON_PHI to CPU

COMPILER_LIB = -L/opt/mpss/2.2/sysroots/k1om-mpss-linux/usr/lib64/  
# old path was -L/usr/linux-k1om-4.7/linux-k1om/usr/lib64/ 

CARD_CC         =       $(KNCPREFIX)gcc
CARD_CXX        =       $(KNCPREFIX)gcc
CARD_LD         =       $(KNCPREFIX)ld
CARD_AR         =       $(KNCPREFIX)ar

CARD_CFLAGS     =       -O0 -g	-std=c89
CARD_CXXFLAGS   =       -O0 -g	
CARD_LDFLAGS    =       $(COMPILER_LIB) -shared  -lpthread 

CARD_CXXFLAGS+= -D_K1OM_

LIB_INSTALL_DIR = /opt/mpss/2.2/sysroots/k1om-mpss-linux/usr/lib64/
# Previously used: /opt/intel/mic/myo/lib

.PHONY : all clean install build

all : libmyodbl-service.so libmyodbl-client.so

install : libmyodbl-service.so libmyodbl-client.so
	sudo cp -dr --no-preserve=ownership libmyodbl-service.so libmyodbl-client.so $(LIB_INSTALL_DIR)

build: libmyodbl-service.so libmyodbl-client.so

#Objects
$(DBL_SERVICE_C_OBJS): %.service.o: %.c
	$(CARD_CC) $(CARD_CFLAGS) $(HAS_DEBUGGER) $(INCL_DIRS) -fPIC -c $^ -o $@
$(DBL_CLIENT_C_OBJS): %.client.o: %.c
	$(HOST_CC) $(HOST_CFLAGS) $(HAS_DEBUGGER) $(INCL_DIRS) -fPIC -c $^ -o $@

# Rules for building 
libmyodbl-service.so : $(DBL_SERVICE_C_OBJS)
	$(CARD_CC) $(CARD_LDFLAGS) -shared $^ -o $@
	mkdir -p $(OUT_DIR)
	cp $@ $(OUT_DIR)

libmyodbl-client.so: $(DBL_CLIENT_C_OBJS)
	$(HOST_CXX) $(HOST_LDFLAGS) -shared $^ -o $@ -shared -Wl,--version-script linker_script.map
	mkdir -p $(OUT_DIR)
	cp $@ $(OUT_DIR)

clean:
	/bin/rm -f $(DBL_CLIENT_C_OBJS) $(DBL_SERVICE_C_OBJS) 
	/bin/rm -f $(OUT_DIR)/libmyodbl-*.so libmyodbl-*.so

ipcrm:
	-ipcs -m|grep 0x|awk '{print "-M", $$1}'|xargs ipcrm
	-ipcs -s|grep 0x|awk '{print "-S", $$1}'|xargs ipcrm
